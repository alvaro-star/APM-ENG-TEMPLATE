# ---------------------------------------------------------------
# Variáveis do docker-compose (raiz do projeto)
# Copie para .env:  cp .env.example .env
# As variáveis do Laravel ficam em backend/.env
# ---------------------------------------------------------------

# Usuário do host que roda os containers (evita arquivos como root)
# Descubra com: id -u  /  id -g
UID=1000
GID=1000

# --- PostgreSQL (serviço db) ---
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret
# Porta exposta no host (dentro da rede do Docker é sempre 5432)
DB_FORWARD_PORT=5433

# --- Portas expostas no host ---
APP_PORT=8000
VITE_PORT=5173
